\newlabel{deployment-readiness-a-gono-go-checklist}{{14.8}{308}{Deployment readiness: a go/no-go checklist}{section.14.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14.1}{\ignorespaces A deployment-readiness checklist. Each dimension pairs the question the team must answer with the signal that separates a defensible promotion decision from a premature one. The checklist is deliberately conservative: a single no-go row is sufficient reason to remain in shadow mode.}}{308}{table.14.1}\protected@file@percent }
\newlabel{tbl-deployment-readiness}{{14.1}{308}{A deployment-readiness checklist. Each dimension pairs the question the team must answer with the signal that separates a defensible promotion decision from a premature one. The checklist is deliberately conservative: a single no-go row is sufficient reason to remain in shadow mode}{table.14.1}{}}
\BKM@entry{id=225,dest={73656374696F6E2E31342E39},srcline={11784},srcfile={2E2F696E6465782E746578}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {14.3}{\ignorespaces A human-in-the-loop workflow for a public-health triage or surveillance model in a resource-constrained setting. The model scores each incoming case, but its output meets a human gate before any action. High-confidence routine cases are batch-reviewed; flagged or low-confidence cases receive individual review; anything the model cannot handle is escalated. No branch lets the model act unmediated, and every branch logs an outcome that feeds the monitoring loop.}}{310}{figure.caption.40}\protected@file@percent }
\newlabel{fig-human-gate}{{14.3}{310}{A human-in-the-loop workflow for a public-health triage or surveillance model in a resource-constrained setting. The model scores each incoming case, but its output meets a human gate before any action. High-confidence routine cases are batch-reviewed; flagged or low-confidence cases receive individual review; anything the model cannot handle is escalated. No branch lets the model act unmediated, and every branch logs an outcome that feeds the monitoring loop}{figure.caption.40}{}}
