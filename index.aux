\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces A task and architecture taxonomy for multimodal medical AI. Inputs (images, text, physiological signals) pass through modality-specific encoders into a shared multimodal model, which serves several downstream tasks. Model families are placed where they are strongest: RETFound and BiomedCLIP as vision and vision-language encoders, GatorTron as a clinical text encoder, MedSAM for segmentation, and general or medical multimodal LLMs (Med-Gemini, BiomedGPT) for report generation and visual question answering.}}{160}{figure.caption.22}\protected@file@percent }
\newlabel{fig-multimodal-taxonomy}{{7.1}{160}{A task and architecture taxonomy for multimodal medical AI. Inputs (images, text, physiological signals) pass through modality-specific encoders into a shared multimodal model, which serves several downstream tasks. Model families are placed where they are strongest: RETFound and BiomedCLIP as vision and vision-language encoders, GatorTron as a clinical text encoder, MedSAM for segmentation, and general or medical multimodal LLMs (Med-Gemini, BiomedGPT) for report generation and visual question answering}{figure.caption.22}{}}
