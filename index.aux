\@writefile{lof}{\contentsline {figure}{\numberline {14.2}{\ignorespaces Schematic of the Google Flu Trends failure: a search-based influenza nowcast (gold) tracks the reference surveillance estimate (blue) well for an early season, then drifts persistently above it, at the 2013 peak overestimating by roughly a factor of two. The values are illustrative, drawn to match the pattern reported by Lazer et al. (2014) rather than the exact series. The dashed band marks a monitoring threshold; sustained excursions beyond it are the signal that should trigger human review, retraining, or rollback.}}{305}{figure.caption.39}\protected@file@percent }
\newlabel{fig-google-flu}{{14.2}{305}{Schematic of the Google Flu Trends failure: a search-based influenza nowcast (gold) tracks the reference surveillance estimate (blue) well for an early season, then drifts persistently above it, at the 2013 peak overestimating by roughly a factor of two. The values are illustrative, drawn to match the pattern reported by Lazer et al. (2014) rather than the exact series. The dashed band marks a monitoring threshold; sustained excursions beyond it are the signal that should trigger human review, retraining, or rollback}{figure.caption.39}{}}
\BKM@entry{id=223,dest={73656374696F6E2E31342E37},srcline={11628},srcfile={2E2F696E6465782E746578}}{}
