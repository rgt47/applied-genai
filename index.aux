\@writefile{lof}{\contentsline {figure}{\numberline {12.1}{\ignorespaces Selected AI-governance milestones for health, 2019 to 2026 (dates approximate, for orientation). Binding instruments (red) are recent and, in the EU case, still phasing in; the guidance and voluntary frameworks (blue, gold) arrived earlier and remain the working reference for research that is not a regulated medical device.}}{262}{figure.caption.34}\protected@file@percent }
\newlabel{fig-governance-timeline}{{12.1}{262}{Selected AI-governance milestones for health, 2019 to 2026 (dates approximate, for orientation). Binding instruments (red) are recent and, in the EU case, still phasing in; the guidance and voluntary frameworks (blue, gold) arrived earlier and remain the working reference for research that is not a regulated medical device}{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.2}{\ignorespaces A decision path for placing an AI activity under the right regime. The first split is research versus clinical care or product deployment; a tool that informs a clinical decision follows the right branch toward FDA SaMD and the EU AI Act, while research data flows follow the left branch toward the IRB and HIPAA. The voluntary frameworks (NIST, WHO, CHAI) supply governance structure on either side.}}{263}{figure.caption.35}\protected@file@percent }
\newlabel{fig-regulatory-decision}{{12.2}{263}{A decision path for placing an AI activity under the right regime. The first split is research versus clinical care or product deployment; a tool that informs a clinical decision follows the right branch toward FDA SaMD and the EU AI Act, while research data flows follow the left branch toward the IRB and HIPAA. The voluntary frameworks (NIST, WHO, CHAI) supply governance structure on either side}{figure.caption.35}{}}
